# GRAS dashboard configuration. Copy to .env and fill in. Never commit .env.

# Postgres (local container only; port is bound to 127.0.0.1)
POSTGRES_USER=gras
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gras

# Google Earth Engine
# Google Cloud project registered for Earth Engine (required).
EE_PROJECT=your-ee-project-id
# Auth option 1 (recommended): put a service-account key at ./secrets/ee-service-account.json
#   The service account needs the "Earth Engine Resource Viewer" role and the
#   project must be registered for Earth Engine.
# Auth option 2: paste the key JSON inline instead (one line).
EE_CREDENTIALS_JSON=

# Optional: Gemini API key for the Assistant page (https://aistudio.google.com/apikey).
# Without it the rest of the dashboard works and the Assistant explains how to enable it.
GEMINI_API_KEY=
# Model id; gemini-3.8-flash has a free tier. Free-tier prompts may be used by Google
# to improve its products, so use a paid key for anything that is not public data.
GEMINI_MODEL=gemini-3.8-flash
# Optional backup when Gemini is busy: a free Groq key (https://console.groq.com/keys).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Host port for the dashboard.
APP_PORT=8501
